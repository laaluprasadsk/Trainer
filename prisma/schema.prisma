datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  TRAINER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  LOCKED
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_TRAINER
  DISPUTED
}

enum SessionLocationType {
  CLIENT_HOME
  TRAINER_GYM
  PUBLIC_PARK
  ONLINE
}

enum PaymentStatus {
  REQUIRES_ACTION
  HELD_IN_ESCROW
  TRANSFERRED
  REFUNDED
  REFUND_PENDING
  FAILED
}

model User {
  emailVerifiedAt DateTime? @map("email_verified_at")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  id           String        @id @default(uuid())
  email        String        @unique
  phoneNumber  String        @unique @map("phone_number")
  passwordHash String        @map("password_hash")
  role         UserRole
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  sessions       Session[]
  tokens         AuthToken[]
  notifications  Notification[]
  uploads        Upload[]
  clientProfile  ClientProfile?
  trainerProfile TrainerProfile?

  @@map("users")
}

model ClientProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  avatarUrl           String?  @map("avatar_url")
  fitnessGoals        String[] @map("fitness_goals")
  defaultLocationName String?  @map("default_location_name")
  createdAt           DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  reviews      Review[]
  parqWaiver   ParqWaiver?
  trainerNotes ClientNote[]

  @@map("client_profiles")
}

model TrainerProfile {
  id                   String                @id @default(uuid())
  userId               String                @unique @map("user_id")
  firstName            String                @map("first_name")
  lastName             String                @map("last_name")
  avatarUrl            String?               @map("avatar_url")
  slug                 String                @unique
  bio                  String?
  yearsExperience      Int                   @default(0) @map("years_experience")
  specializations      String[]
  acceptedSessionModes SessionLocationType[] @default([]) @map("accepted_session_modes")
  hourlyRate           Decimal               @map("hourly_rate") @db.Decimal(10, 2)
  currency             String                @default("INR")
  verificationStatus   VerificationStatus    @default(UNVERIFIED) @map("verification_status")
  isPublished           Boolean               @default(false) @map("is_published")
  homeLocationName     String                @map("home_location_name")
  serviceRadiusKm      Decimal               @default(10.0) @map("service_radius_km") @db.Decimal(5, 2)
  ratingAvg            Decimal               @default(0.00) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount          Int                   @default(0) @map("rating_count")
  stripeAccountId      String?               @map("stripe_account_id")
  createdAt            DateTime              @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications    Certification[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]
  reviews           Review[]
  clientNotes       ClientNote[]

  @@map("trainer_profiles")
}

model Certification {
  id                  String             @id @default(uuid())
  trainerId           String             @map("trainer_id")
  title               String
  issuingOrganization String             @map("issuing_organization")
  credentialId        String?            @map("credential_id")
  documentUrl         String             @map("document_url")
  status              VerificationStatus @default(PENDING)
  issuedDate          DateTime?          @map("issued_date")
  expiryDate          DateTime?          @map("expiry_date")
  verifiedAt          DateTime?          @map("verified_at")
  adminReviewNote     String?            @map("admin_review_note")
  createdAt           DateTime           @default(now()) @map("created_at")

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("certifications")
}

model AvailabilitySlot {
  id        String     @id @default(uuid())
  trainerId String     @map("trainer_id")
  slotDate  DateTime   @map("slot_date") @db.Date
  startTime String     @map("start_time")
  endTime   String     @map("end_time")
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now()) @map("created_at")

  trainer  TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([trainerId, slotDate, startTime])
  @@index([trainerId, slotDate, status])
  @@map("availability_slots")
}

model Booking {
  id                  String              @id @default(uuid())
  clientId            String              @map("client_id")
  trainerId           String              @map("trainer_id")
  slotId              String              @map("slot_id")
  status              BookingStatus       @default(PENDING_PAYMENT)
  locationType        SessionLocationType @map("location_type")
  addressText         String?             @map("address_text")
  totalAmount         Decimal             @map("total_amount") @db.Decimal(10, 2)
  platformFee         Decimal             @map("platform_fee") @db.Decimal(10, 2)
  trainerPayout       Decimal             @map("trainer_payout") @db.Decimal(10, 2)
  currency            String              @default("INR")
  expiresAt           DateTime?           @map("expires_at")
  sessionOtp          String?             @map("session_otp")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  proposedDate        DateTime?           @map("proposed_date") @db.Date
  proposedStartTime   String?             @map("proposed_start_time")
  proposedEndTime     String?             @map("proposed_end_time")
  trainerResponseNote String?             @map("trainer_response_note")

  client  ClientProfile    @relation(fields: [clientId], references: [id])
  trainer TrainerProfile   @relation(fields: [trainerId], references: [id])
  slot    AvailabilitySlot @relation(fields: [slotId], references: [id])
  payment Payment?
  review  Review?

  @@map("bookings")
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique @map("booking_id")
  gatewayOrderId   String        @unique @map("gateway_order_id")
  gatewayPaymentId String?       @unique @map("gateway_payment_id")
  grossAmount      Decimal       @map("gross_amount") @db.Decimal(10, 2)
  platformFee      Decimal       @map("platform_fee") @db.Decimal(10, 2)
  trainerAmount    Decimal       @map("trainer_amount") @db.Decimal(10, 2)
  status           PaymentStatus @default(REQUIRES_ACTION)
  createdAt        DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  clientId  String   @map("client_id")
  trainerId String   @map("trainer_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking        @relation(fields: [bookingId], references: [id])
  client  ClientProfile  @relation(fields: [clientId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerId], references: [id])

  @@index([clientId])
  @@index([trainerId])
  @@map("reviews")
}

model ParqWaiver {
  id                   String   @id @default(uuid())
  clientId             String   @unique @map("client_id")
  hasHeartCondition    Boolean  @map("has_heart_condition")
  hasChestPainActivity Boolean  @map("has_chest_pain_activity")
  hasDizzinessLoss     Boolean  @map("has_dizziness_loss")
  hasBoneJointProblem  Boolean  @map("has_bone_joint_problem")
  takingBpHeartMed     Boolean  @map("taking_bp_heart_med")
  knowsOtherReason     Boolean  @map("knows_other_reason")
  requiresMedClearance Boolean  @default(false) @map("requires_med_clearance")
  isCleared            Boolean  @default(true) @map("is_cleared")
  signedAt             DateTime @default(now()) @map("signed_at")

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("parq_waivers")
}

model ClientNote {
  id            String   @id @default(uuid())
  trainerId     String   @map("trainer_id")
  clientId      String   @map("client_id")
  content       String   @default("")
  targetWeights String?  @map("target_weights")
  injuryNotes   String?  @map("injury_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  client  ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
  @@index([clientId])
  @@index([trainerId, updatedAt])
  @@map("client_notes")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}

model AuthToken {
  id        String   @id
  userId    String   @map("user_id")
  kind      String
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model RateLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

model Notification {
  deliveries MessageDelivery[]
  smsTemplate String? @map("sms_template")
  smsVariables Json? @map("sms_variables")
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model AdminAction {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  targetId  String   @map("target_id")
  action    String
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_actions")
}

model Upload {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  mime      String
  public    Boolean  @default(false)
  data      Bytes?
  storagePath String? @map("storage_path")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("uploads")
}

model MessageDelivery {
  id String @id
  notificationId String @map("notification_id")
  channel String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  leaseUntil DateTime? @map("lease_until")
  leaseToken String? @map("lease_token")
  providerId String? @map("provider_id")
  lastError String? @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("message_deliveries")
}

model PhoneChallenge {
  userId String @id @map("user_id")
  phone String
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at")
  resendAt DateTime @map("resend_at")
  @@map("phone_challenges")
}

model SupportRequest {
  id         String   @id @default(uuid())
  requestKey String   @unique @map("request_key")
  email      String
  message    String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("support_requests")
}

model PlatformSettings {
  id String @id @default("platform")
  commissionBps Int @default(1500) @map("commission_bps")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("platform_settings")
}
