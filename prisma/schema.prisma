datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CLIENT
  TRAINER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum SlotStatus {
  AVAILABLE
  LOCKED
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_TRAINER
  DISPUTED
}

enum SessionLocationType {
  CLIENT_HOME
  TRAINER_GYM
  PUBLIC_PARK
  ONLINE
}

enum PaymentStatus {
  REQUIRES_ACTION
  HELD_IN_ESCROW
  TRANSFERRED
  REFUNDED
  FAILED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  phoneNumber  String        @unique @map("phone_number")
  passwordHash String        @map("password_hash")
  role         UserRole
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  clientProfile  ClientProfile?
  trainerProfile TrainerProfile?

  @@map("users")
}

model ClientProfile {
  id                  String      @id @default(uuid())
  userId              String      @unique @map("user_id")
  firstName           String      @map("first_name")
  lastName            String      @map("last_name")
  avatarUrl           String?     @map("avatar_url")
  fitnessGoals        String[]    @map("fitness_goals")
  defaultLocationName String?     @map("default_location_name")
  createdAt           DateTime    @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  reviews    Review[]
  parqWaiver ParqWaiver?

  @@map("client_profiles")
}

model TrainerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  firstName          String             @map("first_name")
  lastName           String             @map("last_name")
  slug               String             @unique
  bio                String?
  yearsExperience    Int                @default(0) @map("years_experience")
  specializations    String[]
  hourlyRate         Decimal            @db.Decimal(10, 2) @map("hourly_rate")
  currency           String             @default("INR")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  homeLocationName   String             @map("home_location_name")
  serviceRadiusKm    Decimal            @default(10.0) @db.Decimal(5, 2) @map("service_radius_km")
  ratingAvg          Decimal            @default(0.00) @db.Decimal(3, 2) @map("rating_avg")
  ratingCount        Int                @default(0) @map("rating_count")
  stripeAccountId    String?            @map("stripe_account_id")
  createdAt          DateTime           @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications    Certification[]
  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]
  reviews           Review[]

  @@map("trainer_profiles")
}

model Certification {
  id                  String             @id @default(uuid())
  trainerId           String             @map("trainer_id")
  title               String
  issuingOrganization String             @map("issuing_organization")
  credentialId        String?            @map("credential_id")
  documentUrl         String             @map("document_url")
  status              VerificationStatus @default(PENDING)
  issuedDate          DateTime?          @map("issued_date")
  expiryDate          DateTime?          @map("expiry_date")
  verifiedAt          DateTime?          @map("verified_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model AvailabilitySlot {
  id        String     @id @default(uuid())
  trainerId String     @map("trainer_id")
  slotDate  DateTime   @db.Date @map("slot_date")
  startTime String     @map("start_time")
  endTime   String     @map("end_time")
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now()) @map("created_at")

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  booking Booking?

  @@unique([trainerId, slotDate, startTime])
  @@index([trainerId, slotDate, status])
  @@map("availability_slots")
}

model Booking {
  id            String              @id @default(uuid())
  clientId      String              @map("client_id")
  trainerId     String              @map("trainer_id")
  slotId        String              @unique @map("slot_id")
  status        BookingStatus       @default(PENDING_PAYMENT)
  locationType  SessionLocationType @map("location_type")
  addressText   String?             @map("address_text")
  totalAmount   Decimal             @db.Decimal(10, 2) @map("total_amount")
  platformFee   Decimal             @db.Decimal(10, 2) @map("platform_fee")
  trainerPayout Decimal             @db.Decimal(10, 2) @map("trainer_payout")
  currency      String              @default("INR")
  sessionOtp    String?             @map("session_otp")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  client  ClientProfile    @relation(fields: [clientId], references: [id])
  trainer TrainerProfile   @relation(fields: [trainerId], references: [id])
  slot    AvailabilitySlot @relation(fields: [slotId], references: [id])
  payment Payment?
  review  Review?

  @@map("bookings")
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique @map("booking_id")
  gatewayOrderId   String        @unique @map("gateway_order_id")
  gatewayPaymentId String?       @unique @map("gateway_payment_id")
  grossAmount      Decimal       @db.Decimal(10, 2) @map("gross_amount")
  platformFee      Decimal       @db.Decimal(10, 2) @map("platform_fee")
  trainerAmount    Decimal       @db.Decimal(10, 2) @map("trainer_amount")
  status           PaymentStatus @default(REQUIRES_ACTION)
  createdAt        DateTime      @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique @map("booking_id")
  clientId  String   @map("client_id")
  trainerId String   @map("trainer_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking        @relation(fields: [bookingId], references: [id])
  client  ClientProfile  @relation(fields: [clientId], references: [id])
  trainer TrainerProfile @relation(fields: [trainerId], references: [id])

  @@map("reviews")
}

model ParqWaiver {
  id                   String   @id @default(uuid())
  clientId             String   @unique @map("client_id")
  hasHeartCondition    Boolean  @map("has_heart_condition")
  hasChestPainActivity Boolean  @map("has_chest_pain_activity")
  hasDizzinessLoss     Boolean  @map("has_dizziness_loss")
  hasBoneJointProblem  Boolean  @map("has_bone_joint_problem")
  takingBpHeartMed     Boolean  @map("taking_bp_heart_med")
  knowsOtherReason     Boolean  @map("knows_other_reason")
  requiresMedClearance Boolean  @default(false) @map("requires_med_clearance")
  isCleared            Boolean  @default(true) @map("is_cleared")
  signedAt             DateTime @default(now()) @map("signed_at")

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("parq_waivers")
}