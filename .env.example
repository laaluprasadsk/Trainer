# Local development only. Set a strong password and match it in both URLs.
POSTGRES_PASSWORD=replace-with-your-local-password
DATABASE_URL=postgresql://trainer:replace-with-your-local-password@localhost:5432/trainer
DIRECT_URL=postgresql://trainer:replace-with-your-local-password@localhost:5432/trainer
# Exact origin, no trailing slash. .env.local overrides .env in Next.js.
APP_URL=http://localhost:3000
# Razorpay test keys for development; never commit populated values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional password-reset email delivery.
RESEND_API_KEY=
EMAIL_FROM=
# Optional reminder/cleanup job bearer secret.
CRON_SECRET=
# Set temporarily when running npm run db:admin; remove afterwards.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
# SERVER SETTINGS / SECRETS: required for production uploads and verification.
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BOOKING_CONFIRMED_FLOW_ID=
MSG91_BOOKING_CANCELLED_FLOW_ID=
MSG91_BOOKING_REMINDER_FLOW_ID=
# PUBLIC: optional Supabase client configuration; Prisma does not use these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Production APP_URL must be the exact HTTPS application origin.
# Never set NEXT_PUBLIC_ prefixes on database, gateway, SMS, or email secrets.
